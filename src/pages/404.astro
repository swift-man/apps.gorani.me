---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { DEFAULT_LOCALE } from '~/config/site';
import { getUI } from '~/data/i18n';
import { localizedPath } from '~/utils/site';

const t = getUI(DEFAULT_LOCALE);
---

<SiteLayout
  locale={DEFAULT_LOCALE}
  pagePath="404"
  availableLocales={[]}
  noindex
  title={`${t.notFound.title} — Gorani Apps`}
  description={t.notFound.description}
>
  <section class="page-hero compact error-page">
    <div class="shell narrow">
      <p class="eyebrow">404</p>
      <h1>{t.notFound.title}</h1>
      <p>{t.notFound.message}</p>
      <a class="primary-button" href={localizedPath(DEFAULT_LOCALE)}>
        {t.notFound.backHome}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</SiteLayout>
