---
import AppFAQ from '~/components/apps/AppFAQ.astro';
import AppStoreButton from '~/components/apps/AppStoreButton.astro';
import type { Locale } from '~/config/site';
import { siteConfig } from '~/config/site';
import type { AppInfo } from '~/data/apps';
import { getUI } from '~/data/i18n';
import SiteLayout from '~/layouts/SiteLayout.astro';
import { localizedPath } from '~/utils/site';
interface Props {
  locale: Locale;
  app: AppInfo;
}
const { locale, app } = Astro.props;
const t = getUI(locale);
const content = app.content[locale];
const troubleshooting =
  locale === 'ko'
    ? [
        '앱과 기기를 최신 버전으로 업데이트해 주세요.',
        '앱을 완전히 종료한 뒤 다시 열어 주세요.',
        '문제가 계속되면 기기 모델과 OS 버전을 함께 알려 주세요.',
      ]
    : locale === 'ja'
      ? [
          'アプリと端末を最新バージョンに更新してください。',
          'アプリを完全に終了して、もう一度開いてください。',
          '問題が続く場合は、端末モデルとOSバージョンもお知らせください。',
        ]
      : [
          'Update the app and device to the latest available versions.',
          'Quit the app completely, then open it again.',
          'If the issue continues, include your device model and OS version.',
        ];
const subject = encodeURIComponent(`[${app.name}] Support request`);
---

<SiteLayout
  locale={locale}
  pagePath={`support/${app.slug}`}
  title={`${app.name} ${t.supportFor} — Gorani Apps`}
  description={content.shortDescription}
  ogImage={app.ogImage}
>
  <section class="support-detail-hero page-hero compact">
    <div class="shell narrow">
      <img src={app.icon} width="112" height="112" alt={`${app.name} icon`} /><p class="eyebrow">
        {app.platform} · {app.category}
      </p><h1>{app.name} {t.supportFor}</h1><p>{content.shortDescription}</p>
    </div>
  </section>
  <section class="section">
    <div class="shell support-columns">
      <div>
        <div class="section-heading"><h2>{t.troubleshoot}</h2></div><ol class="troubleshooting-list">
          {
            troubleshooting.map((item, index) => (
              <li>
                <>
                  <span>{index + 1}</span>
                  <p>{item}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div><aside class="support-contact">
        <img src={app.icon} width="64" height="64" alt="" /><h2>{t.contactSupport}</h2><p>
          {siteConfig.supportEmail}
        </p><a class="primary-button" href={`mailto:${siteConfig.supportEmail}?subject=${subject}`}
          >{t.contactSupport}<span aria-hidden="true">→</span></a
        ><AppStoreButton url={app.appStoreUrl} platform={app.platform} locale={locale} compact />{
          app.privacyStatus === 'published' && (
            <a class="text-link" href={localizedPath(locale, `privacy/${app.slug}`)}>
              {t.privacyPolicy}
            </a>
          )
        }
      </aside>
    </div>
  </section>
  <section class="section section-bordered">
    <div class="shell narrow"><div class="section-heading"><h2>{t.faq}</h2></div><AppFAQ items={content.faq} /></div>
  </section>
</SiteLayout>
