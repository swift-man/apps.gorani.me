---
import type { CollectionEntry } from 'astro:content';
import BlogCard from '~/components/blog/BlogCard.astro';
import type { Locale } from '~/config/site';
import { getUI } from '~/data/i18n';
import SiteLayout from '~/layouts/SiteLayout.astro';
interface Props {
  locale: Locale;
  posts: CollectionEntry<'post'>[];
}
const { locale, posts } = Astro.props;
const t = getUI(locale);
const localizedPosts = posts
  .filter((post) => post.data.locale === locale)
  .sort((a, b) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0));
---

<SiteLayout
  locale={locale}
  pagePath="blog"
  title={`${t.blogPageTitle} — Gorani Apps`}
  description={t.blogPageDescription}
>
  <section class="page-hero compact">
    <div class="shell"><p class="eyebrow">Journal</p><h1>{t.blogPageTitle}</h1><p>{t.blogPageDescription}</p></div>
  </section>
  <section class="section">
    <div class="shell">
      <div class="blog-grid blog-directory">
        {localizedPosts.map((post) => <BlogCard post={post} locale={locale} />)}
      </div>
    </div>
  </section>
</SiteLayout>
