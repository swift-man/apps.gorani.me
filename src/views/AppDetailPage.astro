---
import AppFAQ from '~/components/apps/AppFAQ.astro';
import AppFeatureGrid from '~/components/apps/AppFeatureGrid.astro';
import AppHero from '~/components/apps/AppHero.astro';
import AppScreenshotGallery from '~/components/apps/AppScreenshotGallery.astro';
import AppStoreButton from '~/components/apps/AppStoreButton.astro';
import LatestUpdates from '~/components/apps/LatestUpdates.astro';
import RelatedApps from '~/components/apps/RelatedApps.astro';
import type { Locale } from '~/config/site';
import { siteConfig } from '~/config/site';
import type { AppInfo } from '~/data/apps';
import { getUI } from '~/data/i18n';
import { updates } from '~/data/updates';
import SiteLayout from '~/layouts/SiteLayout.astro';
import { absoluteUrl, appPath, localizedPath } from '~/utils/site';
interface Props {
  locale: Locale;
  app: AppInfo;
}
const { locale, app } = Astro.props;
const t = getUI(locale);
const content = app.content[locale];
const hasUpdates = updates.some((update) => update.appSlug === app.slug);
const appUrl = absoluteUrl(siteConfig.siteUrl, localizedPath(locale, appPath(app.slug)));
const softwareLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  operatingSystem: app.platform,
  applicationCategory: app.category,
  description: content.seoDescription,
  url: appUrl,
  image: absoluteUrl(siteConfig.siteUrl, app.ogImage),
};
if (app.appStoreUrl) softwareLd.installUrl = app.appStoreUrl;
const jsonLd = [
  softwareLd,
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl(siteConfig.siteUrl, localizedPath(locale)) },
      {
        '@type': 'ListItem',
        position: 2,
        name: t.appsTitle,
        item: absoluteUrl(siteConfig.siteUrl, localizedPath(locale, 'apps')),
      },
      { '@type': 'ListItem', position: 3, name: app.name, item: appUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<SiteLayout
  locale={locale}
  pagePath={appPath(app.slug)}
  title={content.seoTitle}
  description={content.seoDescription}
  ogImage={app.ogImage}
  jsonLd={jsonLd}
  bodyClass={`app-theme-page app-theme--${app.theme}`}
>
  <AppHero app={app} locale={locale} />
  <section class="section app-intro"><div class="shell narrow"><p>{content.longDescription}</p></div></section>
  <section class="section app-section">
    <div class="shell">
      <div class="section-heading"><p class="eyebrow">01</p><h2>{t.features}</h2></div><AppFeatureGrid
        features={content.features}
      />
    </div>
  </section>
  <section class="section app-section screenshots-section">
    <div class="shell">
      <div class="section-heading"><p class="eyebrow">02</p><h2>{t.screenshots}</h2></div><AppScreenshotGallery
        app={app}
        locale={locale}
      />
    </div>
  </section>
  <section class="section app-section">
    <div class="shell">
      <div class="section-heading"><p class="eyebrow">03</p><h2>{t.howItWorks}</h2></div><ol class="steps-grid">
        {
          content.steps.map((step, index) => (
            <li>
              <>
                <span>{index + 1}</span>
                <div>
                  <>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  {
    app.privacyStatus === 'published' && (
      <section class="section app-section privacy-callout">
        <div class="shell narrow">
          <p class="eyebrow">{t.privacy}</p>
          <h2>{t.privacySummary}</h2>
          <a class="text-link" href={localizedPath(locale, `privacy/${app.slug}`)}>
            {t.readPrivacy}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }
  <section class="section app-section">
    <div class="shell">
      <div class="section-heading"><p class="eyebrow">04</p><h2>{t.faq}</h2></div><AppFAQ items={content.faq} />
    </div>
  </section>
  {
    hasUpdates && (
      <section class="section app-section">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow">Changelog</p>
            <h2>{t.updatesTitle}</h2>
          </div>
          <LatestUpdates locale={locale} appSlug={app.slug} limit={1} />
        </div>
      </section>
    )
  }
  <section class="section app-final">
    <div class="shell narrow">
      <img src={app.icon} width="96" height="96" alt="" loading="lazy" /><h2>{app.name}</h2><p>
        {content.shortDescription}
      </p><AppStoreButton url={app.appStoreUrl} platform={app.platform} locale={locale} /><a
        class="text-link"
        href={localizedPath(locale, 'apps')}>{t.allApps}<span aria-hidden="true">→</span></a
      >
    </div>
  </section>
  <section class="section related-apps">
    <div class="shell">
      <div class="section-heading"><h2>{t.relatedApps}</h2></div><RelatedApps locale={locale} currentSlug={app.slug} />
    </div>
  </section>
</SiteLayout>
