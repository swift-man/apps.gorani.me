---
import type { Locale } from '~/config/site';
import { getUI } from '~/data/i18n';

interface Props {
  url: string | null;
  platform: string;
  locale: Locale;
  compact?: boolean;
}
const { url, platform, locale, compact = false } = Astro.props;
const t = getUI(locale);
const label = platform === 'macOS' ? t.macAppStore : platform === 'Apple TV' ? t.tvAppStore : t.appStore;
---

{
  url ? (
    <a class:list={['store-button', { compact }]} href={url} target="_blank" rel="noopener noreferrer">
      <>
        <span class="store-button-overline">Download on the</span>
        <strong>{label}</strong>
        <span aria-hidden="true">↗</span>
      </>
    </a>
  ) : (
    <span class="coming-soon-badge">{t.comingSoon}</span>
  )
}
