---
import { SUPPORTED_LOCALES, type Locale } from '~/config/site';
import { localeLabels } from '~/data/i18n';
import { localizedPath } from '~/utils/site';

interface Props {
  locale: Locale;
  pagePath: string;
  availableLocales?: readonly Locale[];
  label: string;
}
const { locale, pagePath, availableLocales = SUPPORTED_LOCALES, label } = Astro.props;
const availableLocaleSet = new Set(availableLocales);
const parentPath = pagePath.includes('/') ? pagePath.slice(0, pagePath.lastIndexOf('/')) : '';
---

<div class="language-switcher">
  <label class="sr-only" for="language-select">{label}</label>
  <select id="language-select" aria-label={label} data-language-select>
    {
      SUPPORTED_LOCALES.map((item) => (
        <option
          value={localizedPath(item, availableLocaleSet.has(item) ? pagePath : parentPath)}
          selected={item === locale}
        >
          {localeLabels[item]}
        </option>
      ))
    }
  </select>
</div>

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-language-select]').forEach((select) => {
    select.addEventListener('change', () => {
      window.location.href = select.value;
    });
  });
</script>
