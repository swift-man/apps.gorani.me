---
import { SUPPORTED_LOCALES, siteConfig, type Locale } from '~/config/site';
import { absoluteUrl, localizedPath } from '~/utils/site';

interface Props {
  locale: Locale;
  pagePath: string;
  availableLocales?: readonly Locale[];
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const {
  locale,
  pagePath,
  availableLocales = SUPPORTED_LOCALES,
  title,
  description,
  ogImage = '/og-gorani.webp',
  type = 'website',
} = Astro.props;
const canonical = absoluteUrl(siteConfig.siteUrl, localizedPath(locale, pagePath));
const imageUrl = absoluteUrl(siteConfig.siteUrl, ogImage);
const alternateLocales = [...new Set(availableLocales)];
const xDefaultLocale = alternateLocales.includes(siteConfig.defaultLocale) ? siteConfig.defaultLocale : locale;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  alternateLocales.map((item) => (
    <link rel="alternate" hreflang={item} href={absoluteUrl(siteConfig.siteUrl, localizedPath(item, pagePath))} />
  ))
}
<link
  rel="alternate"
  hreflang="x-default"
  href={absoluteUrl(siteConfig.siteUrl, localizedPath(xDefaultLocale, pagePath))}
/>
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.siteName} />
<meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : locale === 'ja' ? 'ja_JP' : 'en_US'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
